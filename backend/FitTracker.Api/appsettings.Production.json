{
    "ConnectionStrings": {
        "DefaultConnection": "Host=postgres;Port=5499;Database=fittracker;Username=postgres;Password=postgres"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
                "System": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext,-40} {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "/app/logs/fittracker-.txt",
                    "rollingInterval": "Day",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
                    "retainedFileCountLimit": 30,
                    "fileSizeLimitBytes": 104857600,
                    "rollOnFileSizeLimit": true,
                    "shared": false
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "/app/logs/errors/fittracker-errors-.txt",
                    "rollingInterval": "Day",
                    "restrictedToMinimumLevel": "Error",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
                    "retainedFileCountLimit": 90,
                    "fileSizeLimitBytes": 104857600,
                    "rollOnFileSizeLimit": true,
                    "shared": false
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            "WithProcessId"
        ],
        "Properties": {
            "Application": "FitTracker.Api",
            "Environment": "Production"
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        //"AllowedOrigins": [
        //	"https://yourdomain.com",
        //	"https://www.yourdomain.com",
        //	"https://app.yourdomain.com"
        //]
        "AllowedOrigins": [
            "http://localhost:4200",
            "http://localhost:3000",
            "http://localhost:5000"
        ]
    },
    //"Security": {
    //	"RequireHttps": true,
    //	"UseHsts": true,
    //	"HstsMaxAge": 31536000
    //},
    //"RateLimiting": {
    //	"Enabled": true,
    //	"PermitLimit": 100,
    //	"Window": 60,
    //	"QueueLimit": 10
    //}
    "Jwt": {
        "Key": "your_super_secret_32_symbols_key",
        "Issuer": "FitTracker.Api",
        "Audience": "FitTracker.App",
        "EmailVerificationTokenValidityInMinutes": 60,
        "TokenValidityInDays": 7
    },
    "App": {
        "VerificationLinkBase": "https://localhost:5000/api/auth/verify-email"
    }
}
