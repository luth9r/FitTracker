%%{init: {'look':'neo', 'theme':'redux-color'}}%%
sequenceDiagram
    participant C as Client
    participant AC as AuthController
    participant UR as UserRepository
    participant DB as PostgreSQL
    participant JTG as JwtTokenGenerator
    participant ES as EmailService
    participant SMTP as SMTP Server
    participant Inbox as User Email

    C->>AC: POST /api/auth/forgot-password<br/>{email}
    AC->>UR: FindByEmail(email)
    UR->>DB: SELECT * FROM Users WHERE Email = ?
    DB-->>UR: User found
    UR-->>AC: user
    
    AC->>JTG: GenerateToken(userId, purpose: "password-reset")
    JTG-->>AC: resetToken (expires 30min)
    
    %% EMAIL EVENT
    par PasswordResetEmailEvent
        AC->>ES: SendPasswordResetEmail(email, token)
        ES->>SMTP: SMTP POST<br/>Subject: Password Reset<br/>Body: Click link to reset password
        SMTP->>Inbox: Password Reset Email
        ES-->>AC: Email sent
    and MainResponse
        AC-->>C: 200 OK {message: "Check your email"}
    end
