%%{init: {'look':'neo', 'theme':'redux-color'}}%%
sequenceDiagram
    participant C as Client
    participant AC as AuthController
    participant JTV as JwtTokenValidator
    participant PH as PasswordHasher
    participant UR as UserRepository
    participant DB as PostgreSQL
    participant ES as EmailService

    C->>AC: POST /api/auth/reset-password?token=xxx<br/>{newPassword}
    AC->>JTV: ValidateToken(token, "password-reset")
    JTV->>JTV: Verify signature<br/>Check expiration<br/>Verify purpose
    JTV-->>AC: userId
    
    AC->>PH: HashPassword(newPassword)
    PH-->>AC: hashedPassword
    
    AC->>UR: UpdatePassword(userId, hashedPassword)
    UR->>DB: UPDATE Users<br/>SET PasswordHash = ?<br/>WHERE Id = ?
    DB-->>UR: Updated
    UR-->>AC: Success
    
    AC-->>C: 204 OK
